#!/usr/bin/env bash

cd "$(dirname "$0")/.."

program=./node_modules/.bin/markdownlint
expected_version=$(node -p 'require("./package-lock.json").packages["node_modules/markdownlint-cli"].version')
installed_version=

if test -x "$program"; then
  installed_version=$(node "$program" --version)
fi

if [[ "$installed_version" != "$expected_version" ]]; then
  npm ci --ignore-scripts --include=dev || exit 1
fi

exec node "$program" "$@"
